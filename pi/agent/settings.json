{
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "transport": "sse",
  "httpIdleTimeoutMs": 600000,
  "websocketConnectTimeoutMs": 15000,
  "compaction": {
    "enabled": true,
    "reserveTokens": 65536,
    "keepRecentTokens": 12000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 3000,
    "provider": {
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "quietStartup": true,
  "extensions": [
    "~/Projects/pi-pretty-tools",
    "~/Projects/agentmemory"
  ],
  "packages": [
    "npm:@tintinweb/pi-subagents",
    "npm:pi-ask-user",
    "npm:context-mode",
    "npm:pi-ticktick",
    "npm:pi-websocket-auto-continue"
  ],
  "hideThinkingBlock": false
}
