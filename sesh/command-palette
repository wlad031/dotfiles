#!/usr/bin/env bash
set -u

log="${XDG_CACHE_HOME:-$HOME/.cache}/sesh-command-palette.log"
mkdir -p "$(dirname "$log")"

resolve_target_pane() {
  saved="$(tmux show-option -gqv @command_palette_target_pane 2>/dev/null || true)"
  if [ -n "$saved" ] && tmux display-message -p -t "$saved" '#{pane_id}' >/dev/null 2>&1; then
    printf '%s' "$saved"
    return 0
  fi

  if [ -n "${TV_TMUX_TARGET_PANE:-}" ] && tmux display-message -p -t "$TV_TMUX_TARGET_PANE" '#{pane_id}' >/dev/null 2>&1; then
    printf '%s' "$TV_TMUX_TARGET_PANE"
    return 0
  fi

  if [ -n "${TMUX:-}" ]; then
    tmux display-message -p '#{pane_id}'
    return 0
  fi

  client="$({ tmux list-clients -F '#{client_activity} #{client_name}' 2>/dev/null || true; } | sort -nr | sed -n '1{s/^[0-9]* //;p;}')"
  [ -n "$client" ] || return 1
  tmux display-message -p -t "$client" '#{pane_id}'
}

target="$(resolve_target_pane)" || exit 1
selection="$(tv-fzf command-palette || true)"
cmd="${selection##*|}"

printf '%s selection=%q cmd=%q target=%q\n' "$(date -Is)" "$selection" "$cmd" "$target" >> "$log"

case "$cmd" in
  sesh-new-window)
    TV_TMUX_TARGET_PANE="$target" "$HOME/.config/sesh/new-window" >> "$log" 2>&1
    ;;
  lazygit)
    cwd="$(tmux display-message -p -t "$target" '#{pane_current_path}')"
    printf '%s lazygit cwd=%q target=%q\n' "$(date -Is)" "$cwd" "$target" >> "$log"
    # The picker itself is already running in a tmux popup. Opening another
    # popup synchronously from inside it is unreliable, so schedule Lazygit for
    # immediately after this script exits and tmux closes the picker popup.
    tmux run-shell -b "sleep 0.05; tmux display-popup -E -w 90% -h 90% -d $(printf '%q' "$cwd") -T Lazygit lazygit" >> "$log" 2>&1
    ;;
  chatgpt-usage*)
    cwd="$(tmux display-message -p -t "$target" '#{pane_current_path}')"
    printf '%s chatgpt-usage cwd=%q cmd=%q target=%q\n' "$(date -Is)" "$cwd" "$cmd" "$target" >> "$log"
    # Reuse the picker popup instead of scheduling a second popup. That avoids
    # both the black popup/log redirection and tmux leaving the deferred command
    # text in the active pane.
    cd "$cwd" 2>/dev/null || true
    exec zsh -lc "exec $cmd"
    ;;
  "")
    ;;
  *)
    zsh -lc 'eval "$1"' zsh "$cmd" >> "$log" 2>&1
    ;;
esac
