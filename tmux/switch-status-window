#!/usr/bin/env sh
# Switch a tmux client to a window in the flat status row.
#
# Usage:
#   switch-status-window w@123 @14 /dev/pts/0  # clicked status range
#   switch-status-window next  @14 /dev/pts/0  # next window in flat status order
#   switch-status-window prev  @14 /dev/pts/0  # previous window in flat status order
#   switch-status-window older @14 /dev/pts/0  # older window in recency history
#   switch-status-window newer @14 /dev/pts/0  # newer window in recency history
#   switch-status-window record @14            # record current window for recency history
#
# The status row uses user ranges (w@123) because tmux's built-in window ranges
# only support window indexes in the current session, not windows in other sessions.

mode=${1-}
current_window=${2-}
client=${3-}

window_table() {
  tmux list-windows -a -F '#{session_created} #{window_index} #{window_id} #{session_id}:#{window_index}' 2>/dev/null |
    sort -n -k1,1 -k2,2
}

window_target() {
  window_table | awk -v id="$1" '$3 == id { print $4; exit }'
}

record_window() {
  id=${1-}
  [ -n "$id" ] || exit 0

  # Ignore stale IDs for windows that no longer exist.
  window_target "$id" >/dev/null || exit 0

  history=$(tmux show-option -gqv @status_window_history | tail -n 1)
  index=$(tmux show-option -gqv @status_window_history_index | tail -n 1)
  [ -n "$index" ] || index=0

  new_history=$(printf '%s\n' $history | awk -v id="$id" -v idx="$index" '
    BEGIN { count = 0 }
    NF { items[++count] = $1 }
    END {
      if (count == 0) { print id; exit }
      if (idx < 1 || idx > count) idx = count
      if (items[idx] == id) {
        for (i = 1; i <= count; i++) print items[i]
        exit
      }

      # If user went back in history and then changed window normally, drop the
      # newer future before appending, like a browser/vim jump list.
      count = idx
      if (count < 1) count = 0
      for (i = 1; i <= count; i++) {
        if (items[i] != id) print items[i]
      }
      print id
    }
  ' | paste -sd ' ' -)

  new_index=$(printf '%s\n' $new_history | awk '{ print NF }')
  tmux set-option -gq @status_window_history "$new_history"
  tmux set-option -gq @status_window_history_index "$new_index"
}

case "$mode" in
  record)
    record_window "$current_window"
    exit 0
    ;;
  w@*)
    window_id=${mode#w}
    target=$(window_target "$window_id")
    ;;
  next|prev)
    [ -n "$current_window" ] || current_window=$(tmux display-message -p '#{window_id}' 2>/dev/null) || exit 0
    target=$(window_table | awk -v cur="$current_window" -v dir="$mode" '
      { targets[NR] = $4; if ($3 == cur) current = NR }
      END {
        if (NR == 0) exit
        if (!current) current = 1
        if (dir == "prev") {
          idx = current - 1
          if (idx < 1) idx = NR
        } else {
          idx = current + 1
          if (idx > NR) idx = 1
        }
        print targets[idx]
      }
    ')
    ;;
  older|newer)
    [ -n "$current_window" ] || current_window=$(tmux display-message -p '#{window_id}' 2>/dev/null) || exit 0
    record_window "$current_window"

    history=$(tmux show-option -gqv @status_window_history | tail -n 1)
    index=$(tmux show-option -gqv @status_window_history_index | tail -n 1)
    [ -n "$index" ] || index=1

    set -- $history
    count=$#
    [ "$count" -gt 0 ] || exit 0

    if [ "$mode" = older ]; then
      index=$((index - 1))
      [ "$index" -ge 1 ] || index=1
    else
      index=$((index + 1))
      [ "$index" -le "$count" ] || index=$count
    fi

    eval "window_id=\${$index}"
    target=$(window_target "$window_id")
    [ -n "$target" ] || exit 0
    tmux set-option -gq @status_window_history_index "$index"
    ;;
  *)
    exit 0
    ;;
esac

[ -n "$target" ] || exit 0

if [ -n "$client" ]; then
  exec tmux switch-client -c "$client" -t "$target"
else
  exec tmux switch-client -t "$target"
fi
